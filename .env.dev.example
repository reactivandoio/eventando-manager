# Desenvolvimento em Docker (REA-21). O make dev copia este arquivo para .env.dev (fora do git).
# Sem segredo nenhum aqui: as chaves abaixo são só de desenvolvimento e públicas.
# Dentro do container o .env é o .env.dev; o .env da máquina não é lido.
# O banco é o MySQL do docker-compose.dev.yml (definido lá, não aqui).
NODE_ENV=development
HOST=0.0.0.0

APP_KEYS=dev-only-app-key-1,dev-only-app-key-2
API_TOKEN_SALT=dev-only-api-token-salt
ADMIN_JWT_SECRET=dev-only-admin-jwt-secret
TRANSFER_TOKEN_SALT=dev-only-transfer-token-salt
JWT_SECRET=dev-only-jwt-secret

# E-mail: sem credenciais o envio falha e só aparece no log; nada sai para ninguém.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=dev@localhost
EMAIL_REPLY_TO=dev@localhost

# Opa Pingou desligado: só a inscrição gratuita passa. Para testar pagamento, use uma chave de
# sandbox no seu .env.dev (nunca no git) e OPAPINGOU_ACCEPT_TEST_MODE=true.
OPAPINGOU_ENABLED=false
OPAPINGOU_API_URL=https://api.opapingou.com.br
OPAPINGOU_API_KEY=
OPAPINGOU_CHARGE_VALIDITY=FIFTEEN_MIN
OPAPINGOU_MIN_CHARGE_CENTS=1
OPAPINGOU_ACCEPT_TEST_MODE=true
SIGNUP_REQUIRE_CPF=false

# Se a recarga de código não pegar alterações (alguns setups de macOS), ligue o polling:
# CHOKIDAR_USEPOLLING=true
