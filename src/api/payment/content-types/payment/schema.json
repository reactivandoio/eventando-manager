{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "value": {
      "type": "biginteger"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "payments"
    },
    "signup": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::signup.signup",
      "mappedBy": "payment"
    },
    "payment_identification": {
      "type": "uid"
    },
    "payment_data": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "PEDING_PAYMENT",
        "CANCELED",
        "CONFIRMED",
        "REFUND",
        "EXPIRED"
      ],
      "default": "PEDING_PAYMENT"
    },
    "confirmed_at": {
      "type": "datetime"
    },
    "canceled_at": {
      "type": "datetime"
    },
    "refunded_at": {
      "type": "datetime"
    },
    "pix_qr_code": {
      "type": "text"
    },
    "batch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::batch.batch",
      "inversedBy": "payments"
    },
    "coupon": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::coupon.coupon",
      "inversedBy": "payments"
    },
    "original_value": {
      "type": "biginteger"
    },
    "payment_link": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "PIX_QR",
        "PAYMENT_LINK"
      ]
    },
    "provider_charge_id": {
      "type": "string"
    },
    "previous_charge_ids": {
      "type": "text"
    },
    "provider_txid": {
      "type": "string"
    },
    "provider_idempotency_key": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "default": 1
    },
    "pix_br_code": {
      "type": "text"
    },
    "expires_at": {
      "type": "datetime"
    },
    "expired_at": {
      "type": "datetime"
    },
    "discount_kind": {
      "type": "enumeration",
      "enum": [
        "coupon",
        "student"
      ]
    },
    "discount_cents": {
      "type": "biginteger"
    },
    "min_charge_applied": {
      "type": "boolean",
      "default": false
    }
  }
}
