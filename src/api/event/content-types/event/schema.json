{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "pixai_token_integration": {
      "type": "text"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "event"
    },
    "signups": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::signup.signup",
      "mappedBy": "event"
    },
    "payment_option": {
      "displayName": "Payment Options",
      "type": "component",
      "repeatable": true,
      "component": "payment.payment-options"
    },
    "sales": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sale.sale",
      "mappedBy": "event"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "event"
    },
    "max_slots": {
      "type": "integer"
    },
    "coupons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::coupon.coupon",
      "mappedBy": "event"
    },
    "slug": {
      "type": "string",
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "unique": true
    },
    "uuid": {
      "type": "uid"
    },
    "payment_provider": {
      "type": "enumeration",
      "enum": [
        "pixai",
        "opapingou"
      ],
      "default": "pixai"
    },
    "opapingou_connection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::opapingou-connection.opapingou-connection",
      "inversedBy": "events",
      "private": true
    },
    "opapingou_legacy": {
      "type": "boolean",
      "default": false
    }
  }
}
